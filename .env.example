# ============ 鏍?.env.example锛坉ocker-compose 鐢級============
# 澶嶅埗涓?.env锛? copy .env.example .env

# ---- 搴旂敤 ----
APP_NAME=Comet
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173

# ---- Model providers ----
# Fill this with your Zhipu API key, then run:
# powershell -ExecutionPolicy Bypass -File .\scripts\configure-zhipu-embedding.ps1
ZHIPU_API_KEY=

# ---- Enterprise knowledge ----
# Host directory mounted read-only into API/worker containers.
CONNECTOR_LOCAL_PATH=./connector-data
CONNECTOR_SYNC_INTERVAL_SECONDS=900
KNOWLEDGE_QUERY_EXPANSION_ENABLED=true
KNOWLEDGE_QUERY_EXPANSION_COUNT=3
# Full MinerU HTTP parse endpoint. Empty keeps the built-in PDF parser fallback.
MINERU_ENDPOINT=
MINERU_API_KEY=
MINERU_TIMEOUT_SECONDS=300
MINERU_FALLBACK_ENABLED=true
AUTO_WIKI_MAX_CHUNKS=5000
AUTO_WIKI_MAX_PAGES=200

# ---- Federated retrieval quality ----
FEDERATED_QUALITY_MAX_CANDIDATES=12
FEDERATED_LLM_REVIEW_LIMIT=8
FEDERATED_LLM_ACCEPT_SCORE=0.55
FEDERATED_FASTPASS_ENABLED=true

# ---- Durable SSE (single instance defaults) ----
STREAM_INSTANCE_ID=comet-api-1
STREAM_INTERNAL_URL=http://comet-api:8000
# Multi-instance deployments must use the same strong random secret on every API instance.
STREAM_FORWARD_SECRET=
STREAM_ROUTE_TTL_SECONDS=60
STREAM_POLL_INTERVAL_SECONDS=0.75
STREAM_EVENT_RETENTION_HOURS=24
STREAM_RUN_STALE_SECONDS=1800

# ---- 瀹夊叏 ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# 鐢熸垚锛歱ython -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-fernet-key

# ---- PostgreSQL ----
POSTGRES_USER=comet
POSTGRES_PASSWORD=comet
POSTGRES_DB=comet

# ---- Neo4j ----
NEO4J_USER=neo4j
NEO4J_PASSWORD=cometneo4j

# 璇存槑锛氬鍣ㄩ棿鍦板潃锛圥OSTGRES_HOST/ES_HOST/NEO4J_URI/REDIS_URL 绛夛級
# 宸插湪 docker-compose.yml 鐨?environment 涓鐩栦负鏈嶅姟鍚嶏紝鏃犻渶鍦ㄦ璁剧疆銆?# 鏈湴瑁歌窇鍚庣鏃讹紝璇风敤 api/.env.example 閲岀殑 localhost 閰嶇疆銆?
